{
  "name": "@sonora/api",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "test": "pnpm run generate && vitest run",
    "test:unit": "pnpm run generate && vitest run --project unit",
    "test:integration": "pnpm run generate && vitest run --project integration",
    "typecheck": "pnpm run generate && tsc --noEmit",
    "build": "pnpm run generate && tsc -p tsconfig.build.json",
    "dev": "sh scripts/dev.sh",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sonora/kernel": "workspace:*",
    "cors": "2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
