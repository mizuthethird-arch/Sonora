generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ExternalSource {
  JAMENDO
}

model User {
  id            String         @id @default(uuid(7)) @db.Char(36)
  email         String         @unique @db.VarChar(254)
  passwordHash  String         @db.VarChar(255)
  displayName   String         @db.VarChar(100)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  playlists     Playlist[]
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  familyId  String    @db.Char(36)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Artist {
  id             String         @id @default(uuid(7)) @db.Char(36)
  name           String         @db.VarChar(255)
  externalSource ExternalSource
  externalId     String         @db.VarChar(64)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  albums         Album[]
  tracks         Track[]

  @@unique([externalSource, externalId])
  @@fulltext([name])
}

model Album {
  id             String         @id @default(uuid(7)) @db.Char(36)
  title          String         @db.VarChar(255)
  artistId       String         @db.Char(36)
  externalSource ExternalSource
  externalId     String         @db.VarChar(64)
  releasedAt     DateTime?      @db.Date
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  artist         Artist         @relation(fields: [artistId], references: [id], onDelete: Restrict)
  tracks         Track[]

  @@unique([externalSource, externalId])
  @@index([artistId])
  @@fulltext([title])
}

model Track {
  id                String          @id @default(uuid(7)) @db.Char(36)
  title             String          @db.VarChar(255)
  artistId          String          @db.Char(36)
  albumId           String?         @db.Char(36)
  durationSeconds   Int             @db.UnsignedInt
  externalSource    ExternalSource
  externalId        String          @db.VarChar(64)
  license           String          @db.VarChar(64)
  downloadAllowed   Boolean
  allowsDerivatives Boolean
  audioObjectKey    String?         @db.VarChar(1024)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  artist            Artist          @relation(fields: [artistId], references: [id], onDelete: Restrict)
  album             Album?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  playlistTracks    PlaylistTrack[]

  @@unique([externalSource, externalId])
  @@index([artistId])
  @@index([albumId])
  @@fulltext([title])
}

model Playlist {
  id        String          @id @default(uuid(7)) @db.Char(36)
  userId    String          @db.Char(36)
  name      String          @db.VarChar(100)
  isPublic  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks    PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  playlistId String   @db.Char(36)
  trackId    String   @db.Char(36)
  position   Int      @db.UnsignedInt
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@unique([playlistId, position])
  @@index([trackId])
}
