# Copy this file to .env and fill in the values. Never commit .env.
# MODULE_DB_PASSWORD: password for the module database users (required, development only).
# TRAEFIK_PORT: host port for Traefik on 127.0.0.1 (default 80).
# JAMENDO_CLIENT_ID: needed only to build the full seed manifest (a later step).
MODULE_DB_PASSWORD=
TRAEFIK_PORT=80
JAMENDO_CLIENT_ID=
